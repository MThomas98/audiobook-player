{
    "name": "Morgiobooks",
    "version": "1.0.0",
    "description": "A simple audiobook reader, made because I couldn't find a good one that works on Windows.",
    "main": "dist/main/main.js",
    "scripts": {
        "build": "tsc && vite build",
        "start": "npm run build && electron .",
        "dev-start": "tsc && node scripts/dev.mjs",
        "lint": "eslint .",
        "format": "eslint . --fix",
        "test-media": "node scripts/make-test-media.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^44.7.2",
        "eslint": "^10.12.0",
        "eslint-plugin-import-x": "^4.17.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "music-metadata": "^12.2.1"
    }
}
