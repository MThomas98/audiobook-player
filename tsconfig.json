    "compilerOptions": {
        "target": "es2025",
        "module": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "noEmitOnError": true,
        "types": ["node"],
        "sourceMap": true,
        "moduleDetection": "auto"
    },
    "include": ["src"],
    "exclude": ["src/page"]
}
